package com.extra.marketplace.presentation.feature.{feature_group}.{feature_path}

import androidx.navigation.NavController
import androidx.navigation.NavGraphBuilder
import androidx.navigation.NavOptions
import androidx.navigation.compose.composable
import androidx.navigation.toRoute
import com.extra.marketplace.presentation.navigation.Route

// =============================================================================
// Navigation Extension - Call this to navigate TO this screen
// =============================================================================

// Simple navigation (no parameters):
fun NavController.navigateTo{FeatureName}(navOptions: NavOptions? = null) =
    navigate(Route.{FeatureName}, navOptions)

// Navigation with parameters:
// fun NavController.navigateTo{FeatureName}(
//     someParam: String,
//     navOptions: NavOptions? = null
// ) = navigate(Route.{FeatureName}(someParam), navOptions)

// =============================================================================
// NavGraphBuilder Extension - Registers this screen's composable
// =============================================================================

fun NavGraphBuilder.{featureName}Screen(
    navController: NavController,
) {
    // For routes WITHOUT parameters:
    composable<Route.{FeatureName}> {
        {FeatureName}ScreenRoot(
            navigate = { destination ->
                navigate(
                    destination = destination,
                    navController = navController,
                )
            }
        )
    }

    // For routes WITH parameters (pass Route object, not individual params):
    // composable<Route.{FeatureName}> { backStackEntry ->
    //     val route = backStackEntry.toRoute<Route.{FeatureName}>()
    //
    //     {FeatureName}ScreenRoot(
    //         route = route,
