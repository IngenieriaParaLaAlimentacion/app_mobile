    //         // Optional: for passing results back
    //         setBackResult = { result ->
    //             navController.previousBackStackEntry?.savedStateHandle?.set(
    //                 RESULT_KEY,
    //                 result
    //             )
    //         }
    //     )
    // }
}

// =============================================================================
// Internal Navigation Handler
// =============================================================================

internal fun navigate(
    destination: {FeatureName}Destination,
    navController: NavController,
) {
    when (destination) {
        is {FeatureName}Destination.Back -> navController.popBackStack()
        // Add handlers for other destinations:
        // is {FeatureName}Destination.SomeScreen -> {
        //     navController.navigateToSomeScreen(destination.param)
        // }
    }
}

// Optional: Result key constant (if passing results back)
// private const val RESULT_KEY = "{feature_name}_result"

// =============================================================================
// GUIDELINES:
// =============================================================================
// 1. navigateTo{FeatureName}() - Extension on NavController for external use
// 2. {featureName}Screen() - Extension on NavGraphBuilder for route registration
// 3. Use composable<Route.{FeatureName}> with type-safe routes
// 4. Extract route params with backStackEntry.toRoute<Route.{FeatureName}>()
// 5. Internal navigate() handles all destination cases
// 6. Pass navigate lambda to ScreenRoot
