-- editId is the wire idempotency `id` for ONE edit attempt — deliberately NOT the same
-- value as responseId. responseId is a plain string, not a SQL foreign key: the
-- parent response may live in PendingSurveyResponse (this device's own submission) or may
-- never have a local row at all (an edit of a response fetched from another device via
-- GET /surveys/{surveyId}/responses/{responseId}) — both are valid and gated at the app
-- level, not the schema level.
CREATE TABLE PendingSurveyResponseEdit (
    editId             TEXT    NOT NULL PRIMARY KEY,
    responseId         TEXT    NOT NULL,
    surveyName         TEXT    NOT NULL,
    -- Denormalized display label for the response's target. Named for the establishment-only era;
    -- it now also holds a subject name, or "Anónima". The target itself is immutable on a response
    -- and absent from the PUT body, so the edit queue never needs the id — only something to show.
    establishmentName  TEXT    NOT NULL,
    answersJson        TEXT    NOT NULL,
    eventAt            TEXT    NOT NULL,
    syncState          TEXT    NOT NULL,  -- PENDING|SYNCING|SYNCED|FAILED
    errorMessage       TEXT,
    attemptCount       INTEGER NOT NULL DEFAULT 0,
    createdAt          INTEGER NOT NULL,
    updatedAt          INTEGER NOT NULL,
    -- Path segment of the PUT URL:
    -- /surveys/{surveyId}/responses/{responseId}.
    surveyId           TEXT    NOT NULL DEFAULT '',
    responseNumber     INTEGER,
    ownerUserId        TEXT,
    hasBeenClaimed        INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX PendingSurveyResponseEdit_state ON PendingSurveyResponseEdit(syncState);
CREATE INDEX PendingSurveyResponseEdit_responseId ON PendingSurveyResponseEdit(responseId);

CREATE INDEX PendingSurveyResponseEdit_owner_state ON PendingSurveyResponseEdit(ownerUserId, syncState);
CREATE INDEX PendingSurveyResponseEdit_owner_response ON PendingSurveyResponseEdit(ownerUserId, responseId);

insert:
INSERT INTO PendingSurveyResponseEdit(editId, responseId, surveyName, establishmentName,
    answersJson, eventAt, syncState, errorMessage, attemptCount, createdAt, updatedAt, surveyId, responseNumber, ownerUserId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM PendingSurveyResponseEdit WHERE ownerUserId = :ownerUserId ORDER BY createdAt DESC;

selectSyncable:
SELECT * FROM PendingSurveyResponseEdit WHERE ownerUserId = :ownerUserId AND syncState = 'PENDING' ORDER BY createdAt ASC;

selectAwaitingNumberPolicy:
SELECT * FROM PendingSurveyResponseEdit
WHERE ownerUserId = :ownerUserId AND syncState = 'FAILED'
  AND responseNumber IS NULL
  AND errorMessage = 'Falta el número de respuesta.';

selectUnsentForResponse:
SELECT * FROM PendingSurveyResponseEdit
WHERE ownerUserId = :ownerUserId AND responseId = :responseId
  AND syncState = 'PENDING' AND hasBeenClaimed = 0
LIMIT 1;

selectById:
SELECT * FROM PendingSurveyResponseEdit WHERE ownerUserId = :ownerUserId AND editId = :editId;

selectLatestForResponse:
SELECT * FROM PendingSurveyResponseEdit
WHERE ownerUserId = :ownerUserId AND responseId = :responseId
ORDER BY createdAt DESC
LIMIT 1;

updatePending:                     -- overwrite an unsent edit in place, no new idempotency key
UPDATE PendingSurveyResponseEdit SET surveyName = ?, establishmentName = ?, answersJson = ?,
    eventAt = ?, responseNumber = ?, updatedAt = ? WHERE ownerUserId = :ownerUserId AND editId = :editId;

markSyncing:
UPDATE PendingSurveyResponseEdit SET syncState = 'SYNCING', hasBeenClaimed = 1, updatedAt = ?
WHERE ownerUserId = :ownerUserId AND editId = :editId;

resetSyncingToPending:
UPDATE PendingSurveyResponseEdit SET syncState = 'PENDING', updatedAt = ? WHERE ownerUserId = :ownerUserId AND syncState = 'SYNCING';

bumpRetry:
UPDATE PendingSurveyResponseEdit SET syncState = 'PENDING', attemptCount = attemptCount + 1,
    errorMessage = ?, updatedAt = ? WHERE ownerUserId = :ownerUserId AND editId = :editId;

pruneTerminalOlderThan:
DELETE FROM PendingSurveyResponseEdit
WHERE ownerUserId = :ownerUserId AND (syncState = 'SYNCED' OR syncState = 'FAILED') AND updatedAt < :cutoff;

markSynced:
UPDATE PendingSurveyResponseEdit SET syncState = 'SYNCED', errorMessage = NULL, updatedAt = ?
WHERE ownerUserId = :ownerUserId AND editId = :editId;

markFailed:
UPDATE PendingSurveyResponseEdit SET syncState = 'FAILED', errorMessage = ?,
    attemptCount = attemptCount + 1, updatedAt = ? WHERE ownerUserId = :ownerUserId AND editId = :editId;

resetForRetry:
UPDATE PendingSurveyResponseEdit SET syncState = 'PENDING', errorMessage = NULL, attemptCount = 0,
    updatedAt = ? WHERE ownerUserId = :ownerUserId AND editId = :editId;

deleteForOwner:
DELETE FROM PendingSurveyResponseEdit WHERE ownerUserId = :ownerUserId;
