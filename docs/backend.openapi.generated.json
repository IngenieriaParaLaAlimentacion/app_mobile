{
  "openapi": "3.1.0",
  "info": {
    "title": "Ingenieria para la Alimentación",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/establishments": {
      "get": {
        "tags": [
          "Establishments"
        ],
        "summary": "List all establishments",
        "description": "Returns all establishments available for a manager to register with.Supports optional search filtering by establishment name or address.",
        "operationId": "get_establishments_api_v1_establishments_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number, starting at 1.",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number, starting at 1."
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Number of establishments per page (max 100).",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Number of establishments per page (max 100)."
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedEstablishmentsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register/establishment-manager": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register establishment manager",
        "description": "Creates a new establishment manager account pending admin approval.",
        "operationId": "register_manager_api_v1_auth_register_establishment_manager_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterManagerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "User already exists",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Establishments not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List registered users",
        "description": "Returns a paginated list of users, optionally filtered by role or status, or searching by name, last name or email. Accessible by admins only.",
        "operationId": "list_users_api_v1_admin_users_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/UserRole"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by role.",
              "title": "Role"
            },
            "description": "Filter by role."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/UserStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by status.",
              "title": "Status"
            },
            "description": "Filter by status."
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedUsersResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated user does not have admin privileges",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/managers/{user_id}/establishments/approve": {
      "patch": {
        "tags": [
          "Admin"
        ],
        "summary": "Approve establishment access for a manager",
        "description": "Approves the given establishments for the manager and activates the manager's account. Accessible by admins only.",
        "operationId": "approve_establishments_api_v1_admin_managers__user_id__establishments_approve_patch",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "User Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EstablishmentAccessRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid authentication token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated user does not have admin privileges",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Manager or establishment not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/managers/{user_id}/establishments/reject": {
      "patch": {
        "tags": [
          "Admin"
        ],
        "summary": "Reject establishment access for a manager",
        "description": "Rejects the given establishments for the manager. Does not affect the manager's account status. Accessible by admins only.",
        "operationId": "reject_establishments_api_v1_admin_managers__user_id__establishments_reject_patch",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "User Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EstablishmentAccessRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or invalid authentication token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated user does not have admin privileges",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Manager or establishment not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subjects": {
      "post": {
        "tags": [
          "Subjects"
        ],
        "summary": "Register a new subject",
        "description": "Creates a new subject. Accessible by establishment managers only.",
        "operationId": "create_subject_api_v1_subjects_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubjectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubjectResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "Subject already exists",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EstablishmentAccessRequest": {
        "properties": {
          "establishment_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "minItems": 1,
            "title": "Establishment Ids"
          }
        },
        "type": "object",
        "required": [
          "establishment_ids"
        ],
        "title": "EstablishmentAccessRequest"
      },
      "EstablishmentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "address": {
            "type": "string",
            "title": "Address"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "address"
        ],
        "title": "EstablishmentResponse"
      },
      "PaginatedEstablishmentsResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EstablishmentResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total_pages": {
            "type": "integer",
            "title": "Total Pages"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "title": "PaginatedEstablishmentsResponse"
      },
      "PaginatedUsersResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/UserAdminView"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total_pages": {
            "type": "integer",
            "title": "Total Pages"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "title": "PaginatedUsersResponse"
      },
      "RegisterManagerRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "last_name": {
            "type": "string",
            "minLength": 1,
            "title": "Last Name"
          },
          "establishments": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "minItems": 1,
            "title": "Establishments"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password",
          "name",
          "last_name",
          "establishments"
        ],
        "title": "RegisterManagerRequest"
      },
      "RegistrationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "last_name": {
            "type": "string",
            "title": "Last Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "establishments": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Establishments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "last_name",
          "role",
          "status",
          "establishments"
        ],
        "title": "RegistrationResponse"
      },
      "Sex": {
        "type": "string",
        "enum": [
          "male",
          "female"
        ],
        "title": "Sex",
        "description": "Biological sex of a subject."
      },
      "SubjectRequest": {
        "properties": {
          "dni": {
            "type": "integer",
            "maximum": 99999999.0,
            "minimum": 1.0,
            "title": "Dni"
          },
          "sex": {
            "$ref": "#/components/schemas/Sex"
          },
          "name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Name"
          },
          "last_name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Last Name"
          },
          "birth_date": {
            "type": "string",
            "format": "date",
            "title": "Birth Date"
          },
          "is_rural": {
            "type": "boolean",
            "title": "Is Rural",
            "description": "Bool indicating if the subject belongs to a rural population"
          },
          "is_indigenous": {
            "type": "boolean",
            "title": "Is Indigenous",
            "description": "Bool indicating if the subject belongs to an indigenous population"
          }
        },
        "type": "object",
        "required": [
          "dni",
          "sex",
          "name",
          "last_name",
          "birth_date",
          "is_rural",
          "is_indigenous"
        ],
        "title": "SubjectRequest"
      },
      "SubjectResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "dni": {
            "type": "integer",
            "title": "Dni"
          },
          "sex": {
            "$ref": "#/components/schemas/Sex"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "last_name": {
            "type": "string",
            "title": "Last Name"
          },
          "birth_date": {
            "type": "string",
            "format": "date",
            "title": "Birth Date"
          },
          "is_rural": {
            "type": "boolean",
            "title": "Is Rural"
          },
          "is_indigenous": {
            "type": "boolean",
            "title": "Is Indigenous"
          }
        },
        "type": "object",
        "required": [
          "id",
          "dni",
          "sex",
          "name",
          "last_name",
          "birth_date",
          "is_rural",
          "is_indigenous"
        ],
        "title": "SubjectResponse"
      },
      "UserAdminView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "last_name": {
            "type": "string",
            "title": "Last Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "establishments": {
            "items": {
              "$ref": "#/components/schemas/EstablishmentResponse"
            },
            "type": "array",
            "title": "Establishments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "last_name",
          "role",
          "status",
          "establishments"
        ],
        "title": "UserAdminView"
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "admin",
          "professional",
          "establishment_manager"
        ],
        "title": "UserRole",
        "description": "Roles that determine a user's permissions within the system."
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "active",
          "inactive",
          "pending_validation"
        ],
        "title": "UserStatus",
        "description": "Lifecycle states a user account can be in."
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "default": "about:blank",
            "example": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ]
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/api/v1/auth/login"
          }
        }
      }
    }
  }
}